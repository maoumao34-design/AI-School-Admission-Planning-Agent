{
  "name": "ai-school-admission-planning-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI 升学规划 Agent（高考志愿）— 数据模型 / RLS / 鉴权基座（MAO-2）",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:rls": "psql \"$DIRECT_DATABASE_URL\" -f supabase/rls.sql",
    "db:setup": "prisma generate && prisma migrate deploy && npm run db:rls",
    "seed": "tsx scripts/seed-qa.ts",
    "seed:teardown": "tsx scripts/seed-qa.ts teardown",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
